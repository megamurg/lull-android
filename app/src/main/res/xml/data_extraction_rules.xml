<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (android:dataExtractionRules): the same as backup_rules.xml, for cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
